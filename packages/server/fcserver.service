[Unit]
Description=Fadecandy Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
# The repo copy, not one under /usr/local: engine/power.js reads this same
# file for its gamma and whitepoint, so there is one curve and nothing to sync.
ExecStart=/usr/local/bin/fcserver /home/pi/github/neopixel-light-panel/packages/server/fcserver.json
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
